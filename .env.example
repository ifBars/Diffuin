PORT=8787
GITHUB_APP_ID=123456
# Local/Docker Compose: mount the PEM and use GITHUB_PRIVATE_KEY_PATH.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
# Hosted platforms: omit the path and set the PEM as base64 in this secret instead.
# GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
DIFFUIN_HANDLE=Diffuin
ALLOWED_REPOSITORIES=octo-org/example-repo
DATA_DIR=/data
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=max
JOB_POLL_INTERVAL_MS=1000
