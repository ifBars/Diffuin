PORT=8787
GITHUB_APP_ID=123456
# Local/Docker Compose: mount the PEM and use GITHUB_PRIVATE_KEY_PATH.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
# Hosted platforms: omit the path and set the PEM as base64 in this secret instead.
# GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
DIFFUIN_HANDLE=Diffuin
ALLOWED_REPOSITORIES=octo-org/example-repo
DATA_DIR=/data
CODEX_MODEL=gpt-5.6-luna
CODEX_ALLOWED_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
CODEX_REASONING_EFFORT=max
CODEX_REASONING_ROUTING=true
JOB_POLL_INTERVAL_MS=1000
SCHEDULE_ONE_SKILL_PATH=/app/skills/schedule-one-modding
SCHEDULE_ONE_CODE_ARCHIVER_URL=https://github.com/k073l/s1-codearchiver.git
SCHEDULE_ONE_RELATED_REPOSITORIES=https://github.com/ifBars/MoreDrugs.git
# Optional local/self-hosted read-only mount. Do not upload or package AssetRipper exports.
# SCHEDULE_ONE_ASSETRIPPER_PATH=/references/assetripper
